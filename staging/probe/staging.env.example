# Copy only through pnpm mcp:staging:prepare (random secrets; ignored .local/).
# No deployment starts automatically. Never print docker compose config without --quiet.
NODE_ENV=production
POSTGRES_PASSWORD=GENERATE_OWNER_PASSWORD
MCP_RUNTIME_PASSWORD=GENERATE_RUNTIME_PASSWORD
MCP_VERIFIER_PASSWORD=GENERATE_VERIFIER_PASSWORD
MCP_RESOURCE_URL=https://probe.example.invalid/mcp
MCP_RESOURCE_HOST=probe.example.invalid
MCP_OAUTH_ISSUER=https://REPLACE_TENANT.auth0.com/
MCP_OAUTH_JWKS_URL=https://REPLACE_TENANT.auth0.com/.well-known/jwks.json
MCP_OAUTH_METADATA_URL=https://REPLACE_TENANT.auth0.com/.well-known/openid-configuration
MCP_PROBE_SUBJECT=REPLACE_WITH_SYNTHETIC_OAUTH_SUBJECT
MCP_PROBE_ORGANIZATION_ID=
MCP_BUILD_SHA=REPLACE_WITH_REVIEWED_COMMIT_SHA
MCP_STAGING_INIT_CONFIRM=initialize-empty-synthetic-probe-database
# Optional evidence file lives only in .local/mcp-staging/proof.json.
# Exact Work callback/client ID go in the approved IdP, never guessed here.
