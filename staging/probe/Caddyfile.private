{
  admin off
  auto_https off
}
:8080 {
  handle /mcp {
    reverse_proxy mcp:3100 {
      header_up Host {$MCP_RESOURCE_HOST}
      header_up -X-Forwarded-Host
      header_up -X-Forwarded-Proto
    }
  }
  handle /.well-known/oauth-protected-resource* {
    reverse_proxy mcp:3100 {
      header_up Host {$MCP_RESOURCE_HOST}
      header_up -X-Forwarded-Host
      header_up -X-Forwarded-Proto
    }
  }
  handle {
    respond 404
  }
}
