# Use a dedicated PostgreSQL database. setup:local generates local-only secrets.
DATABASE_URL=postgresql://eruty:CHANGE_ME@127.0.0.1:55432/eruty
APP_ORIGIN=http://127.0.0.1:3000
BOOTSTRAP_EMAIL=operator@example.invalid
BOOTSTRAP_PASSWORD=CHANGE_ME_MINIMUM_12_CHARACTERS
# Private, versioning-enabled dedicated S3 bucket. No public ACL/bucket policy.
# storage:local generates random development credentials without printing them.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=eruty-private-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Optional absolute writable quarantine directory; defaults to an app-specific OS temp folder.
# UPLOAD_TMP_DIR=

# Optional separate synthetic MCP process. No server starts without valid settings.
# External OAuth authorization server is not implemented here. Do not paste tokens below.
# MCP_RESOURCE_URL=https://probe.example.invalid/mcp
# MCP_OAUTH_ISSUER=https://auth.example.invalid/
# MCP_OAUTH_JWKS_URL=https://auth.example.invalid/jwks
# MCP_PROBE_ORGANIZATION_ID=UUID_RETURNED_BY_EXPLICIT_PROVISION
# MCP_PORT=3100
# MCP_BIND_HOST=127.0.0.1
# MCP_ALLOWED_ORIGINS=https://chatgpt.com
# MCP_BUILD_SHA=REVIEWED_COMMIT_SHA
# Production non-loopback binding requires NODE_ENV=production and MCP_ALLOW_REMOTE_BIND=true.
# Provision CLI only (existing staff identity, new synthetic organization):
# MCP_PROBE_SETUP_CONFIRM=create-new-synthetic-organization
# MCP_PROBE_USER_EMAIL=operator@example.invalid
# MCP_PROBE_SUBJECT=OAUTH_SUBJECT_FROM_APPROVED_TEST_IDENTITY
# Verify/revoke CLI only:
# MCP_PROBE_ID=UUID_FROM_WRITE_RECEIPT
# MCP_PROBE_GRANT_ID=UUID_FROM_PROVISION

# Separate discovery process: exactly six discovery tools; probe mode stays the default.
# MCP_SERVER_MODE=discovery
# MCP_DISCOVERY_ORGANIZATION_ID=EXPLICIT_ALLOWLIST_ORGANIZATION_UUID
# MCP_DISCOVERY_ALLOW_SYNTHETIC=false
# Optional bounded administrator-managed policy. Apply migration 0008 and runtime grants first.
# Defaults off; enabling changes the environment hash. Does not attest Work/SNS capabilities.
# MCP_DISCOVERY_OPERATING_APPROVALS=false
# MCP_DISCOVERY_OPERATING_APPROVAL_ID=EXPLICIT_APPROVAL_UUID_FOR_REVOKE_ONLY
# Synthetic discovery is rejected in production and requires an enrolled probe sandbox.
# MCP_DISCOVERY_OPERATOR_USER_ID=EXISTING_WRITER_UUID
# MCP_DISCOVERY_GRANT_ID=EXPLICIT_GRANT_UUID
# Supply the independent read-only verifier DB URL in an ignored local env file:
# MCP_DISCOVERY_VERIFIER_DATABASE_URL=
# Dashboard only: reviewed current environment hash from the operator environment command.
# Omit until a real Work/SNS capability review exists. This is not a credential or success flag.
# DISCOVERY_CURRENT_ENVIRONMENT_SHA256=

# STEP 4 automatic AI evaluation: opt-in only. Work JSON import needs no API key.
# Enable the UI only after migration 0009 and evaluation-grants.sql.
# EVALUATION_ENABLED=false
# EVALUATION_AI_ENABLED=false
# OPENAI_API_KEY=
# EVALUATION_MODEL=EXPLICIT_STRUCTURED_OUTPUT_MODEL
# Enable dashboard Codex requests after migration 0011 and restricted runtime setup.
CODEX_DISCOVERY_ENABLED=false
# Enable only after migration 0014 and connecting a trusted local Codex worker.
CODEX_AUTOMATIC_DISCOVERY_ENABLED=false
# Vercel production requires a separate runtime role; the integration's DATABASE_URL
# remains available only for reviewed owner-operated migration commands.
# APP_DATABASE_URL=
