{
  "manifest_version":3,
  "name":"ERUTY 회사 Instagram 연락 실행기",
  "version":"0.1.4",
  "description":"ERUTY에서 확정한 회사 계정·수신자·문장으로 DM 1건을 실행하고 결과를 기록합니다.",
  "minimum_chrome_version":"120",
  "key":"",
  "permissions":["storage","alarms"],
  "host_permissions":["https://www.instagram.com/*","https://eruty-creator-seeding-os.vercel.app/*"],
  "background":{"service_worker":"background.js","type":"module"},
  "content_scripts":[{"matches":["https://www.instagram.com/*"],"js":["instagram.js"],"run_at":"document_idle"}],
  "externally_connectable":{"matches":["https://eruty-creator-seeding-os.vercel.app/*"]},
  "action":{"default_title":"ERUTY 연락 실행기","default_popup":"popup.html"},
  "incognito":"not_allowed"
}
